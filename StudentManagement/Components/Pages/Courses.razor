@page "/courses"

@rendermode InteractiveServer

@using StudentManagement.Models
@using StudentManagement.Services

@inject StudentManagement.Services.StudentService studentService
@inject StudentManagement.Services.CourseService courseService
@inject IJSRuntime JS


<h3 class="page-header">Student Management</h3>

<h7 class="page-header-exp">Academic Administration</h7>
@if (countInfosList.Count >= 3)
{
    <div class="count-container">

        <div class="istatistik-box">
            <IconCard Title="@countInfosList[0].CountHeaderName"
                      Value=@countInfosList[0].HeaderCount
                      IconClass="bi bi-people-fill" />
        </div>

        <div class="istatistik-box">
            <IconCard Title="@countInfosList[1].CountHeaderName"
                      Value=@countInfosList[1].HeaderCount
                      IconClass="bi bi-book" />
        </div>

        <div class="istatistik-box">
            <IconCard Title="@countInfosList[2].CountHeaderName"
                      Value=@countInfosList[2].HeaderCount
                      IconClass="bi bi-window-stack" />
        </div>
    </div>
}

    <br />
<button type="button" class="enroll-btn" @onclick="() => isModalOpen = true">+ Enroll Student</button>

 
<MyModal @bind-isVisible="isModalOpen" Title="Enroll Student" OnConfirm="ConfirmEnrollment" ShowSaveButton="false">

    <div class="modal-div">
     <div class="modal-column">
        <label class="text-label">Student</label>
        <InputSelect class="select-form" @bind-Value="addedStudent">
            <option value="0">Select Student</option>
            @foreach (var student in students)
            {
                <option value="@student.StudentId">@student.Name @student.LastName</option>
            }
        </InputSelect>
    </div>
        <div class="modal-column">
                <label class="text-label">Select Course</label>
            <InputSelect class="select-form" @bind-Value="addedCourse">
                <option value="0">Select Course</option>
                    @foreach (var course in courses)
                    {
                        <option value="@course.CourseId">@course.CourseName</option>
                    }
                </InputSelect> 
                   
        </div>
        <button class="add-btn" type="button" @onclick="@(() => EnrollStudent(addedStudent, addedCourse))">+ Add</button>


    <table class="table table-striped">
        <thead>
                <tr>
                    @foreach (var modalHeader in modalHeaderList)
                    {
                        <th>
                            @modalHeader.HeaderName

                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in @studentAndCoursesList.Where(x => x.StudentId == addedStudent))
                {
                    <tr>                       
                        <td>@item.Course.CourseName</td>
                        <td>
                            <button class="btn-delete" type="button" @onclick="@(() => DeleteRecord(item.StudentId, item.CourseId))">Delete</button>
 
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </MyModal> 

    <div class="filter-form-div">

    <input class="form-search" type="text" @bind="searchingText" @bind:event="oninput" placeholder="Search..." @bind:after="FilterStudentsandCourses" />

    <InputSelect class="form-select" @bind:event="onchange" @bind-Value="selectedCourse" @bind-Value:after="() => FilterStudentsandCourses()">
        <option value="" disabled selected>Select an option</option>
        @foreach (var course in courses)
        {
            <option value="@course.CourseId">@course.CourseName</option>
        }
    </InputSelect>
    
    <button class="clear-btn" @onclick="Clear" type="button" >Clear</button>


    

</div>
<table class="table table-striped">
    <thead>
        <tr>
            @foreach (var header in headerList)
            {
                <th>
                    @header.HeaderName

                </th>
            }
        </tr>
    </thead>
    <tbody>

        @foreach (var item in studentAndCoursesList)
        {
            <tr>
                    <td>@item.Student.Name @item.Student.LastName</td>
                    <td>@item.Course.CourseName</td>
                    <td>
                    <button class="btn-delete" type="button" @onclick="@(() => DeleteRecord(item.StudentId, item.CourseId))">Delete</button>
                    </td> 

                <td>
                </td>
            </tr>
        }

        <div class="pagination-buttons">
            @if (CanGoPrevious)
            {
                <button class="btn-previous" type="button" @onclick="@(() => @PreviousPage())">Previous</button>
            }

            <label>@pageNumber of @totalPage</label>
            @if (CanGoNext)
            {
                <button class="btn-next" type="button" @onclick="@(() => @NextPage())">Next</button>
            }
        </div>
    </tbody>
</table>
@if (isErrorModalOpen)
{
    <MyErrorModal @bind-isVisible="isErrorModalOpen" Title="Error List" OnConfirm="@(() => CloseErrorModal())">
        <ul>
            @foreach (var error in errorList)
            {
                <li class ="error-text">@error</li>
            }
        </ul>       

    </MyErrorModal>
}


@code {
    private int studentCount;
    private int courseCount;
    private int enrollementCount;
    private List<CourseCountsInfos> countInfosList = new();
    private int initializeCount;
    private int addedStudent { get; set; } = new();
    private List<Student> students = new();
    private List<Course> courses = new();
    private int addedCourse{ get; set; } = new();
    private List<string> headerNames = new List<string>() {"Student", "Course", "Action" };
    private List<string> modalHeaderNames = new List<string>() { "Course", "Action" };
    private List<StudentTableHeaders> headerList = new();
    private List<StudentTableHeaders> modalHeaderList = new();
    private int buttonBehavior;
    private string errorMessage = string.Empty;
    private List<string> errorList = new();
    private List<StudentCourse> studentAndCoursesList = new();
    private string searchingText = string.Empty;
    private int selectedCourse;
    private int searchVersion = 0;
    private bool isModalOpen = false;
    private bool isErrorModalOpen = false;
    int pageNumber = 1;
    int pageSize = 5;
    int totalPage;
    private PaginatedResult<StudentCourse>? paginatedResult;

    private bool CanGoNext =>
    paginatedResult is not null &&
    paginatedResult.CurrentPage < paginatedResult.TotalPages;

    private bool CanGoPrevious =>
    paginatedResult is not null &&
    paginatedResult.CurrentPage > 1;

    protected override async Task OnInitializedAsync()
    {
        await GetUpdatedList();

        studentCount = await studentService.GetStudentsCount();
        courseCount = await courseService.GetCourseCountAsync();
        enrollementCount = await courseService.GetEnrollmentCount();

        await courseService.InitializeCoursesAsync();
        initializeCount = 0;
        countInfosList = new List<CourseCountsInfos>
        {
            new("Students", studentCount),
            new("Courses", courseCount),
            new("Enrollments", enrollementCount)
        };

        students = await studentService.GetStudents();
        courses = await courseService.GetCoursesAsync();

        try
        {
            buttonBehavior = 0;           

            foreach (var headerName in headerNames)
            {
                headerList.Add(new StudentTableHeaders
                {
                    HeaderName = headerName,
                    ButtonBehavior = buttonBehavior,
                    UniqueName = "btn-" + headerName
                });
            }

            foreach (var modalHeaderName in modalHeaderNames)
            {
                modalHeaderList.Add(new StudentTableHeaders
                {
                    HeaderName = modalHeaderName,
                    ButtonBehavior = buttonBehavior,
                    UniqueName = "btn-" + modalHeaderName
                });
            }
            //studentAndCoursesList = await courseService.GetEnrollmentsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
    private async Task ConfirmEnrollment()
    {
        await EnrollStudent(addedStudent, addedCourse);

        if (!isErrorModalOpen)
        {
            isModalOpen = false;
        }
    }

    private async Task RefreshStatistics()
    {

        enrollementCount = await courseService.GetEnrollmentCount();
        var enrollmentStatistic = countInfosList.FirstOrDefault(x => x.CountHeaderName == "Enrollments");

        if (enrollmentStatistic != null)
        {
            enrollmentStatistic.HeaderCount = enrollementCount;
        }
    }
    private async Task CloseErrorModal()
    {
        errorList.Clear();
        isErrorModalOpen = false;
    }

    private async Task EnrollStudent(int studentId, int courseId)
    {
        try
        {
            await courseService.EnrollStudentAsync(studentId, courseId);
            studentAndCoursesList = await courseService.GetEnrollmentsAsync();
            errorMessage = "";
            isErrorModalOpen = false;
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
            isErrorModalOpen = true;
        }

        await RefreshStatistics();
        await GetUpdatedList();
    }

    private async Task GetUpdatedList()
    {
        paginatedResult = await courseService.FilteringProcesses(searchingText, selectedCourse, pageNumber, pageSize);

        studentAndCoursesList = paginatedResult.Items;
        totalPage = paginatedResult.TotalPages;
        pageNumber = paginatedResult.CurrentPage;

    }

    private async Task DeleteRecord(int studentId, int courseId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure?");

        if (confirmed)
        {
            await courseService.DeleteEnrollment(studentId, courseId);           
            await GetUpdatedList();
            await RefreshStatistics();

        }
    }

    private async Task PreviousPage()
    {
        try
        {
            paginatedResult = await courseService.FilteringProcesses(searchingText, selectedCourse, pageNumber, pageSize);
            if (paginatedResult != null && pageNumber > 1 && pageNumber <= paginatedResult.TotalPages)
            {
                --pageNumber;
                errorList.Clear();
                await GetUpdatedList();
            }
            if (pageNumber == 1)
            {
                await GetUpdatedList();
            }
        }
        catch (Exception ex)
        {
            errorList.Add(ex.Message);
            isErrorModalOpen = true;
        }

    }

    private async Task NextPage()
    {
        try
        {
            paginatedResult = await courseService.FilteringProcesses(searchingText, selectedCourse, pageNumber, pageSize);
            if (paginatedResult != null && pageNumber < paginatedResult.TotalPages)
            {
                ++pageNumber;
                errorList.Clear();
                await GetUpdatedList();
            }
            if (paginatedResult != null && (pageNumber == paginatedResult.TotalPages || pageNumber > paginatedResult.TotalPages))
            {
                errorList.Clear();

            }
        }
        catch (Exception ex)
        {
            errorList.Add(ex.Message);
            isErrorModalOpen = true;
        }
    }
    private async Task FilterStudentsandCourses()
    {

        int currentVersion = ++searchVersion;
        try
        {
            var results = await courseService.FilteringProcesses(searchingText, selectedCourse, pageNumber,pageSize);

            if (currentVersion != searchVersion)
                return;

            studentAndCoursesList = results.Items;
            errorMessage = "";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (currentVersion != searchVersion)
                return;
            errorMessage = $"An error accured {ex}";
        }
        await GetUpdatedList();

    }

    private async Task Clear()
    {
        searchingText = "";
        selectedCourse = 0;
        await GetUpdatedList();
    }
}
