@page "/"

@rendermode InteractiveServer

@using StudentManagement.Models
@using StudentManagement.Services

@inject StudentManagement.Services.StudentService studentService




<h3>Student Management</h3>
<br />
<label>Total student</label>
<label>@studentCount</label>
<label>Class average</label>
<label>@averageNote</label>
<br /><br />


<input @bind="Name" @bind:event="oninput" placeholder="Enter student name" />
<input @bind="LastName" @bind:event="oninput" placeholder="Enter student last name" />
<input @bind="Midterm" @bind:event="oninput" placeholder="Enter student midterm note" />
<input @bind="Final" @bind:event="oninput" placeholder="Enter final note" />

<button @onclick="() => AddStudent()">Add</button>


@if (isLoading)
{
    <label>@errorTableMessage</label>
}
@if (!isLoading)
{
    <table class="table table-striped">
        <thead>
            <tr>               
                <th>Ad</th>
                <th>Soyad</th>
                <th>Midterm Note</th>
                <th>Final Note</th>
                <th>Average</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in studentList)
            {
                <tr>                   
                    <td>
                    @if(editingId == student.StudentId)
                    {
                        <input @bind="student.Name" />
                        <input @bind="student.LastName" />
                        <input @bind="student.Midterm" />
                        <input @bind="student.Final" />
                    }
                    else
                    {
                        <td>@student.Name</td>
                        <td>@student.LastName</td>
                        <td>@student.Midterm</td>
                        <td>@student.Final</td>
                        <td>@student.Average</td>
                    }
                    </td>
                    <td>
                        @if (editingId == student.StudentId)
                        {
                            <button @onclick="@(() => SaveStudent(student))">Save</button>
                            <button @onclick="@(() => CancelEdit())">Cancel</button>
                        }
                        else
                        {
                            <button @onclick="@(() => @EnableEdit(@student.StudentId))">Update</button>
                            <button @onclick="@(() => @studentService.DeleteStudent(student.StudentId))">Delete</button>
                        }

                    </td>                  
                </tr>
            }
        </tbody>
    </table>
}



<label>@errorMessage</label>



@code {
    private int Id;
    private string Name =string.Empty;
    private string LastName = string.Empty;
    private int Midterm;
    private int Final;
    private string errorMessage = string.Empty;
    private string errorTableMessage = string.Empty;
    private List<Student> studentList;
    private bool isLoading = true;
    private bool isTableShown = false;
    private bool isTableErrorMessageShown = false;
    private int studentCount;
    private double averageNote;
    private int? editingId;

    protected override async Task OnInitializedAsync()
    {
        studentList = await studentService.GetStudents();
        studentCount = studentList.Count;
        isLoading = false;
    }

    private async void AddStudent()
    {
        try
        {
            Student student = new Student(Name,LastName,Midterm,Final);

            await studentService.AddStudent(student);

            await studentService.GetStudents();
            isLoading = false;
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void EnableEdit(int studentId)
    {
        editingId = studentId;
    }

    private async void SaveStudent(Student student)
    {
        studentService.UpdateStudent(student);
        editingId = null;
    }

    private void CancelEdit()
    {
        editingId = null;
    }
