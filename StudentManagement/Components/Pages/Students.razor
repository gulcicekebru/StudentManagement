    //     {
    //         isTableShown = true;
    //         errorTableMessage = "";
    //     }
    //     else if (studentList.Count == 0)
    //     {
    //         isTableShown = false;
    //         errorTableMessage = "No students found.";
    //         isTableErrorMessageShown = true;
    //     }

    // }



}
