@page "/"

@rendermode InteractiveServer

@using StudentManagement.Models
@using StudentManagement.Services

@inject StudentManagement.Services.StudentService studentService



<h3 class="page-header">Students</h3>
<h7 class="page-header-exp">Manage students, view results and class statistics.</h7>
<br />

<div class="container mt-5">
    <div class="row g-3">
        <div class="col-md-4">
            <IconCard Title="Total student"
                      Value=@studentCount
                      IconClass="bi bi-people-fill" />
                      
        </div>

        <div class="col-md-5">
            <IconCard Title="Class average"
                      Value="@Convert.ToInt32(averageNote ?? 0)"
                      IconClass="bi bi-graph-up-arrow" />
        </div>
    </div>
</div>

<br /><br />                 
    <tr @key="editingId"></tr>
    @if (studentToEdit != null)
        {

    <MyModal @bind-isVisible="isModalOpen" Title="Update Student" FormId="student-update-form">

                
        <EditForm Model="@studentToEdit" id="student-update-form"  OnInvalidSubmit="@(context => AddErrorMessagetoList(context))" OnValidSubmit="@(() => SaveStudent(studentToEdit))" Context="myFormContext" FormName="StudentUpdateForm">
        <DataAnnotationsValidator />        
        <div class="form-group">
            <label for="name" class="form-label">Name:</label>
            <InputText id="name" @bind-Value="@studentToEdit.Name" class="form-control" @bind:event="oninput" placeholder="Enter student name" />        
        </div>
        <div class="form-group">
            <label for="lastName" class="form-label">Last Name:</label>
            <InputText id="lastName" @bind-Value="@studentToEdit.LastName" class="form-control" @bind:event="oninput" placeholder="Enter student last name" />            
        </div>
        <div class="form-group">
            <label for="midterm" class="form-label">Midterm:</label>
            <InputNumber id="midterm" @bind-Value="@studentToEdit.Midterm" class="form-control" @bind:event="oninput" placeholder="Enter student midterm note" />            
        </div>
        <div class="form-group">
            <label for="final" class="form-label">Final:</label>
            <InputNumber id="final" @bind-Value="@studentToEdit.Final" class="form-control" @bind:event="oninput" placeholder="Enter student final note" />            
        </div>
        </EditForm>
        </MyModal> 
        }

        <div class="form-table-div">
            <div class="add-form-div">
        <EditForm class="edit-from-add" Model="@student" Context="myFormContext" OnInvalidSubmit="@(context => AddErrorMessagetoList(context))" OnValidSubmit="@(() => AddStudent())" FormName="StudentAddingForm">
        <DataAnnotationsValidator />
        
            <label class="add-text">Add New Student</label>
        <div class="form-group">
            
            <label for="name" class="form-label">Name</label>
            <InputText id="name" @bind-Value="@student.Name" class="form-control" @bind:event="oninput" placeholder="Enter student name" />               
        </div>
        <div class="form-group">
            <label for="lastName" class="form-label">Last Name</label>
            <InputText id="lastName" @bind-Value="@student.LastName" class="form-control" @bind:event="oninput" placeholder="Enter student last name" />        
        </div>
        <div class="form-group">
            <label for="midterm" class="form-label">Midterm</label>
            <InputNumber id="midterm" @bind-Value="@student.Midterm" class="form-control" @bind:event="oninput" placeholder="Enter student midterm note" />            
        </div>
        <div class="form-group">
            <label for="final" class="form-label">Final</label>
            <InputNumber id="final" @bind-Value="@student.Final" class="form-control" @bind:event="oninput" placeholder="Enter student final note" />            
        </div>
        <br />
        <button type="submit" class="btn-add">Add Student</button>
        <button type="button" @onclick="ClearForm" class="btn-clear">Clear</button>


    </EditForm>
    </div>



    @if (isLoading)
    {
        <label>@errorTableMessage</label>
    }
    @if (!isLoading)
    {
        <div class="table-div">
            <EditForm Model="@studentUpdate" Context="myTableContext" OnInvalidSubmit="@(context => AddErrorMessagetoList(context))" OnValidSubmit="@(() => SaveStudent(studentUpdate))" FormName="editForm" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <br />

            <div class="side-by-side">
                @* Search *@
                <input class="form-control-s" type="text" @bind="searchingText" @bind:event="oninput" placeholder="Search..." @bind:after="RefreshStudents" />
                <br />

                @* Gecti mi gecmedi mi filter *@
                <InputSelect @bind-Value="chosenState" class="form-control-se" @bind:event="onchange" @bind-Value:after="() => RefreshStudents()">
                    <option value="" disabled selected>Select an option...</option>
                    @foreach (var chosenState in stateOptions)
                    {
                        <option value="@chosenState">@chosenState</option>
                    }
                </InputSelect>

                    <button type="button" @onclick="ClearFilters" class="btn-clear-filter">Clear Filters</button>
            </div>
            <br />
           

            <table class="table table-striped">
                <thead>
                    <tr>
                        @foreach (var header in headerList)
                        {
                            <th>
                                @header.HeaderName
                                <button id="@header.UniqueName" type="button" class="durum-butonu" data-durum="@header.ButtonBehavior"
                                        @onclick='async () => { chosenOption = $"{header.HeaderName}{header.ButtonBehavior}"; await RefreshStudentsFilter(header.UniqueName); }'>
                                </button>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in studentList)
                    {
                        <tr @key="item.StudentId">

                            <td>@item.Name</td>
                            <td>@item.LastName</td>
                            <td>@item.Midterm</td>
                            <td>@item.Final</td>
                            <td>@((item.Average ?? 0).ToString("F2"))</td>
                            <td>@item.Status</td>

                            <td>
                                <button class="btn-update" type="button" @onclick="@(() => @EnableEdit(item))">Update</button>
                                    <button class="btn-delete" type="button" @onclick="@(() => DeleteRecord(item.StudentId))">Delete</button>
                            </td>

                            <td>
                            </td>
                        </tr>
                        }
                        <div class="pagination-buttons">
                        @if (CanGoPrevious)
                        {
                            <button class="btn-previous" type="button" @onclick="@(() => @PreviousPage())">Previous</button>
                        }
                        
                        <label>@currentPage of @totalPage</label>
                            @if (CanGoNext)
                        {
                            <button class="btn-next" type="button" @onclick="@(() => @NextPage())">Next</button>
                        }
                        </div>

                        
                </tbody>
            </table>

        </EditForm>

            </div>

    }


        </div>
       

@* <label>@errorMessage</label>  *@
@if (isErrorModalOpen)
{
    <MyErrorModal @bind-isVisible="isErrorModalOpen" Title="Error List" OnConfirm="@(() => CloseErrorModal())">
        <ul>
            @foreach (var error in errorList)
            {
                <li class="error-text">@error</li>
            }
        </ul>

    </MyErrorModal>
}

@code {
    [SupplyParameterFromForm(FormName = "StudentAddingForm")]
    private Student student { get; set; } = new();

    [SupplyParameterFromForm(FormName = "editForm")]
    private Student studentUpdate { get; set; } = new();

    private List<string> headerNames = new List<string>(){ "Name", "LastName", "Midterm", "Final", "Average", "Is Passed" };


    private Student studentToEdit { get; set; } = null;
    private int Id;
    private string Name =string.Empty;
    private string LastName = string.Empty;
    private int Midterm;
    private int Final;
    private string errorMessage = string.Empty;
    private string errorTableMessage = string.Empty;
    private List<Student> studentList = new List<Student>();
    private List<Student> searchedStudentList;
    private bool isLoading = true;
    private bool isTableShown = false;
    private bool isTableErrorMessageShown = false;
    private int studentCount;
    private double? averageNote;
    private int? editingId;
    private bool isAddable = false;
    private bool isModalOpen = false;
    private List<string> stateOptions = new List<string>() { "Passed", "Not Passed" };
    private EditContext? editContext;
    private List<string>? errorList = new();



    private int searchVersion = 0;
    private string chosenOption = string.Empty;
    private bool isSearching = false;
    private string searchingText = string.Empty;
    private string chosenState = string.Empty;
    private bool isErrorModalOpen = false;

    private string butonId = "btn-";

    private StudentTableHeaders headers { get; set; } = new();
    private List<StudentTableHeaders> headerList = new();
    private int buttonBehavior;
    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPage;
    private PaginatedResult<Student>? paginatedResult;


    private bool CanGoNext =>
    paginatedResult is not null &&
    paginatedResult.CurrentPage < paginatedResult.TotalPages;

    private bool CanGoPrevious =>
    paginatedResult is not null &&
    paginatedResult.CurrentPage > 1;



    protected override async Task OnInitializedAsync()
    {

        await GetUpdatedList();
        studentCount = await studentService.GetStudentsCount();

        try
        {
            editingId = null;
            buttonBehavior = 0;
            errorMessage = string.Empty;
            averageNote = await studentService.GetClassAverage(await studentService.GetStudents());

            foreach(var headerName in headerNames)
            {
                headerList.Add(new StudentTableHeaders
                    {
                        HeaderName = headerName,
                        ButtonBehavior = buttonBehavior,
                        UniqueName = "btn-" + headerName
                    });
            }            
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
        }

        isLoading = false;

    }

    private async Task GetUpdatedList()
    {

        paginatedResult = await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);

        studentList = paginatedResult.Items;
        totalPage = paginatedResult.TotalPages;
        currentPage = paginatedResult.CurrentPage;
    }

    // private int currentPage = 1;
    // private int pageSize = 10;
    // private PaginatedResult<Student>? paginatedResult;

    private async Task NextPage()
    {
        try
        {
            paginatedResult = await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);
            if(paginatedResult != null && currentPage < paginatedResult.TotalPages)
            {
                ++currentPage;                 
                errorList.Clear();                
                await GetUpdatedList();              
            }
            if (paginatedResult != null && (currentPage == paginatedResult.TotalPages || currentPage > paginatedResult.TotalPages))
            {
                errorList.Clear();

            }           
        }
        catch(Exception ex)
        {
            errorList.Add(ex.Message);
            isErrorModalOpen = true;
        }
        // Son sayfada olup olmadığını kontrol etmeli.
        // Son sayfada değilse currentPage değerini 1 artırmalı.
        // Yeni sayfanın öğrencilerini servisten çekip paginatedResult değişkenine atamalı.
    }

    private async Task PreviousPage()
    {
        try
        {
            paginatedResult = await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);
            if (paginatedResult != null && currentPage > 1 && currentPage <= paginatedResult.TotalPages)
            {
                --currentPage;
                errorList.Clear();
                await GetUpdatedList();
            }
            if(currentPage == 1)
            {
                await GetUpdatedList();
            }
        }
        catch (Exception ex)
        {
            errorList.Add(ex.Message);
            isErrorModalOpen = true;
        }
        // Son sayfada olup olmadığını kontrol etmeli.
        // Son sayfada değilse currentPage değerini 1 artırmalı.
        // Yeni sayfanın öğrencilerini servisten çekip paginatedResult değişkenine atamalı.


    }
    private async Task CloseErrorModal()
    {
        errorList.Clear();
        isErrorModalOpen = false;
    }

    private async Task AddStudent()
    {
        try
        {
            isAddable = true;
            // Student student = new Student(Name,LastName,Midterm,Final);
            errorList.Clear();

            await studentService.AddStudent(student);
            await GetUpdatedList();

            isLoading = false;
            student = new();
            isErrorModalOpen = false;
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
            isAddable = false;

            if(errorList.Count != 0)
            {
                isErrorModalOpen = true;
            }
        }

        await RefreshStatistics();

        //StateHasChanged();
    }

    private void AddErrorMessagetoList(EditContext context)
    {
        errorList = context.GetValidationMessages().ToList();

        isErrorModalOpen = errorList.Count > 0;

    }

    private void ClearForm()
    {
        student = new Student();
        student.Name = string.Empty;
        student.LastName = string.Empty;
        student.Midterm = null;
        student.Final = null;

    }

    private async Task EnableEdit(Student studentEdit)
    {
        editingId = studentEdit.StudentId;
        studentToEdit =  await studentService.GetStudentById(editingId);
        studentUpdate= new Student
            {
                StudentId=studentEdit.StudentId,
                Name = studentEdit.Name,
                LastName = studentEdit.LastName,
                Midterm = studentEdit.Midterm,
                Final = studentEdit.Final
            };
        isModalOpen = true;
        //StateHasChanged();

    }

    private async Task DeleteRecord(int studentId)
    {
        await studentService.DeleteStudent(studentId);
        await RefreshStudents();
        await RefreshStatistics();
        await GetUpdatedList();

        //StateHasChanged();
    }

    private async Task SaveStudent(Student student)
    {
        try
        {
            await studentService.UpdateStudent(student);

            editingId = null;
            studentToEdit = null;
            isErrorModalOpen = false;
            isModalOpen = false;

            errorList.Clear();

            await RefreshStatistics();
            await GetUpdatedList();
        }
        catch(Exception ex)
        {
            errorList = new List<string> { ex.Message };

            isErrorModalOpen = true;

        }


        //StateHasChanged();
    }

    private void CancelEdit()
    {
        editingId = null;
        studentToEdit = null;
    }


    //Filter


    private async Task RefreshStudents()
    {

        int currentVersion = ++searchVersion;
        try
        {
            currentPage = 1;
            await GetUpdatedList();
            var tempPaginated = await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);
            var results = tempPaginated.Items;

            if (currentVersion != searchVersion) 
                return;

            studentList = results;
            errorMessage = "";
            //await OnInitializedAsync();

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            if (currentVersion != searchVersion)
                return;
            errorMessage = $"An error accured {ex}";
        }
        await GetUpdatedList();

    }

    private async Task RefreshStudentsFilter(string uniqueName)
    {       
        try
        {
            currentPage = 1;
            await GetUpdatedList();
            
            var tempPaginated = await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);
            var results = tempPaginated.Items;

            foreach (var eleman in headerList)
            {
                if (eleman.UniqueName == uniqueName)
                {
                    int buttonBehavior = eleman.ButtonBehavior;
                    if (buttonBehavior == 0)
                    {
                        eleman.ButtonBehavior = 1;
                    }
                    else
                    {
                        eleman.ButtonBehavior = 0;
                    }
                }
            }
            errorMessage = "";           

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {           
            errorMessage = $"An error accured {ex}";
        }

    }

    private async Task RefreshStatistics()
    {
        //islemlerden sonra (örn eklemede silmede) kişi sayısını ve ortalamayı degistirecek.
        studentCount = await studentService.GetStudentsCount();
        averageNote = await studentService.GetClassAverage(await studentService.GetStudents());
    }

    private async Task ClearFilters()
    {
        chosenOption = string.Empty;
        isSearching = false;
        searchingText = string.Empty;
        chosenState = string.Empty;
        currentPage = 1;
        await studentService.FilteringProcesses(searchingText, chosenOption, chosenState, currentPage, pageSize);
        await RefreshStatistics();
        await GetUpdatedList();
    }
}
