<div class="card shadow-sm h-100">
    <div class="card-body d-flex align-items-center">
        @* İkon Alanı *@
        <div class="rounded-circle p-3 me-3 text-primary" style="background-color: #F3E8FF; color: #8B5CF6;">
            <i class="@IconClass fs-3" style="color: #8B5CF6;"></i>
        </div>

        @* Metin Alanı *@
        <div>
            <h6 class="card-subtitle mb-1 text-muted">@Title</h6>
            <h4 class="card-title mb-0 fw-bold">@Value</h4>
            @if (!string.IsNullOrEmpty(Description))
            {
                <small class="text-muted">@Description</small>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Başlık";
    [Parameter] public int Value { get; set; } 
    [Parameter] public string IconClass { get; set; } = "bi bi-star-fill";
    [Parameter] public string? Description { get; set; }
}

